# StreamDoc Environment Example
# Copy to .env and adjust paths/secrets.

STREAMDOC_ENV=local
STREAMDOC_SECRET_KEY=replace-me

# Paths
STREAMDOC_DB_PATH=data/State/streamdoc.sqlite
STREAMDOC_MEDIA_ROOT=data/Media
STREAMDOC_OUTPUT_ROOT=data/Outputs
STREAMDOC_MODEL_ROOT=data/Models

# API / Web GUI
STREAMDOC_API_HOST=0.0.0.0
STREAMDOC_API_PORT=5454

# Scheduler
STREAMDOC_SCHEDULER_MAX_WORKERS=3

# YouTube
STREAMDOC_YOUTUBE_API_KEY=

# yt-dlp bypass mode — how StreamDoc avoids YouTube bot detection.
# Options: po_token | cookie | cookies_from_browser | default
# Reason: po_token is the default. It uses a PO Token provider container
# (bgutil-ytdlp-pot-provider) to generate Proof-of-Origin tokens that
# bypass bot detection without needing browser cookies. The container
# is auto-started on app startup if Docker is available; otherwise the
# app falls back to cookies_from_browser.
STREAMDOC_YT_DLP_BYPASS_MODE=po_token
# Browser to read cookies from when mode=cookies_from_browser.
# Options: chrome | edge | firefox | brave | chromium | opera | vivaldi
STREAMDOC_YT_DLP_COOKIES_BROWSER=chrome
# Optional browser profile name (e.g. Default, Profile 1). Leave empty for default.
# STREAMDOC_YT_DLP_COOKIES_BROWSER_PROFILE=
# Fallback bypass mode used when:
#   1. The primary mode fails with a cookie DB lock error (Chrome/Edge
#      running on Windows — yt-dlp issue #7271)
#   2. po_token mode is active but Docker is not available to run the
#      POT provider container
#   3. The primary mode fails with bot detection, rate limiting, or HTTP 403
# Can be a comma-separated chain (tried in order):
#   "default" — no-auth (safe, may hit bot detection on some videos)
#   "cookie,default" — try pre-exported cookie jar, then no-auth
#   "cookies_from_browser" — OPT-IN! Ban risk on personal profiles!
# Options: po_token | cookie | cookies_from_browser | default | (empty = disabled)
# WARNING: cookies_from_browser reads from your ACTIVE browser profile and
# can get your YouTube account banned. Never use it as an automatic fallback.
# Only set it explicitly if you accept the risk and use a dedicated profile.
STREAMDOC_YT_DLP_BYPASS_FALLBACK_MODE=default
# Optional cookie jar path (used when mode=cookie).
STREAMDOC_YT_DLP_COOKIEJAR_PATH=data/cookies/youtube.txt
# Optional POT provider override (defaults to bgutil when mode=po_token)
# STREAMDOC_YT_DLP_POT_PROVIDER=
# PO Token provider container settings.
# URL where the POT provider HTTP server is reachable.
STREAMDOC_POT_PROVIDER_URL=http://127.0.0.1:4416
# Docker image for the POT provider. MUST match the bgutil plugin version
# built into yt-dlp. The official brainicism image (TypeScript/Node.js)
# is used by default — its version matches yt-dlp's built-in plugin.
# Do NOT use ghcr.io/jim60105/bgutil-pot (Rust rewrite) — it uses a
# different versioning scheme and causes a major-version mismatch that
# silently prevents yt-dlp from fetching PO tokens.
STREAMDOC_POT_PROVIDER_IMAGE=brainicism/bgutil-ytdlp-pot-provider:latest
# Docker container name for the POT provider.
STREAMDOC_POT_PROVIDER_CONTAINER_NAME=streamdoc-pot
# When true, the app auto-starts the POT container on startup if Docker
# is available and bypass_mode=po_token. Set to false to manage manually.
STREAMDOC_POT_AUTO_START=true
# Optional static user-agent override
# STREAMDOC_YT_DLP_USER_AGENT=
# JavaScript runtime for yt-dlp's EJS n-challenge solver (required since
# yt-dlp 2026.07). Without this, downloads fail with "Sign in to confirm
# you're not a bot" or "Requested format is not available".
# The yt-dlp-ejs package (challenge solver scripts) is installed automatically.
# Options: node | deno | bun | quickjs | comma-separated (e.g. "node,deno")
# Node.js v22+ is the default (most commonly installed). Deno is yt-dlp's
# own default. You can also specify a path: "node:/path/to/node".
STREAMDOC_YT_DLP_JS_RUNTIMES=node
# Extra raw args appended to yt-dlp, e.g. "--no-check-certificate --proxy socks5://host:1080"
# STREAMDOC_YT_DLP_EXTRA_ARGS=

# NotebookLM Integration
STREAMDOC_NOTEBOOKLM_ENABLED=true
STREAMDOC_NOTEBOOKLM_MODE=storage_state
STREAMDOC_NOTEBOOKLM_STORAGE_STATE_PATH=data/integrations/notebooklm/storage_state.json
STREAMDOC_NOTEBOOKLM_PROFILE=default
STREAMDOC_NOTEBOOKLM_ACCOUNT=
STREAMDOC_NOTEBOOKLM_TEMPLATES_DIR=config/prompts/notebooklm
# Shipped sample prompts (read-only, tracked in git). Copied to TEMPLATES_DIR on first run.
STREAMDOC_NOTEBOOKLM_SAMPLE_PROMPTS_DIR=assets/prompts/notebooklm
STREAMDOC_NOTEBOOKLM_DEFAULT_RETENTION_HOURS=24
STREAMDOC_NOTEBOOKLM_AUTO_UPLOAD=true
STREAMDOC_NOTEBOOKLM_DEFAULT_CONTENT_TYPES=slide_deck,infographic
STREAMDOC_NOTEBOOKLM_DEFAULT_PROMPT=financial_extraction
STREAMDOC_NOTEBOOKLM_DEFAULT_WAIT_TIMEOUT=300
STREAMDOC_NOTEBOOKLM_KEEPALIVE_INTERVAL_MINUTES=30
# Playwright browser channel: chromium (default / bundled), chrome, or msedge.
# Use chrome or msedge only if the bundled Chromium fails to launch.
STREAMDOC_NOTEBOOKLM_BROWSER=chromium
# Verbosity for notebooklm-py internal logging (WARNING | INFO | DEBUG).
STREAMDOC_NOTEBOOKLM_LOG_LEVEL=WARNING
# Optional Chrome DevTools Protocol endpoint for unattended re-auth.
# Start your normal Chrome with --remote-debugging-port=9222, then set this to
# http://localhost:9222. StreamDoc will pass it to notebooklm-py so headless
# re-auth attaches to your live, already-signed-in browser instead of relying
# on the dedicated browser_profile directory (which can go stale on restart).
# Leave blank to use the persistent browser profile only.
STREAMDOC_NOTEBOOKLM_CDP_URL=

# Retention Policy (global defaults — per-preset overrides via preset fields)
# Report files (.md, .pdf) are deleted after this many hours (default: 168 = 7 days)
STREAMDOC_RETENTION_REPORTS_HOURS=168
# Media files (videos, audio, frames) are deleted after this many hours (default: 24)
STREAMDOC_RETENTION_MEDIA_HOURS=24
STREAMDOC_RETENTION_CLEANUP_ENABLED=true
# How often the scheduled cleanup runs (in minutes). Cleanup also runs
# after each preset job completes, but this ensures cleanup happens even
# when jobs hang or the server restarts. Default: 60 minutes.
STREAMDOC_RETENTION_CLEANUP_INTERVAL_MINUTES=60
# Dry-run mode: log what would be deleted without actually deleting
STREAMDOC_RETENTION_DRY_RUN=false
# Per-preset overrides: set file_retention_hours and notebook_retention_hours
# on each preset (via API or YAML). Default is 24h for both.
# Set retention_enabled=false on a preset to disable cleanup entirely (keep forever).

# Transcript prefs
# Whisper model: tiny | base | small | medium | large (small is a good balance)
# Whisper timeout: max seconds for a single transcription (default 600 = 10 min)
# On CPU, "small" can take 30+ min for a 20-min video — the timeout prevents
# one slow video from blocking the entire job.
STREAMDOC_WHISPER_MODEL=small
STREAMDOC_WHISPER_TIMEOUT_SECONDS=600
# yt-dlp subtitle fallback: when youtube-transcript-api fails (rate-limited or
# blocked), fall back to yt-dlp subtitle download using the configured cookie/
# PO-token bypass. Fetches the SAME caption data (no quality difference).
# Default OFF — the official API works for ~90%+ of videos after the v1.x fix.
# Set to true only if you see frequent transcript failures.
STREAMDOC_USE_YT_DLP_SUBTITLES=false

# Antigravity (agy) generation backend — POR-27
# agy is a sibling content-generation backend to NotebookLM. The agy binary
# itself is installed by the operator (npm/npx); StreamDoc owns the skill
# installation + prompt plumbing. Default OFF so existing deployments are
# unaffected until you opt in.
STREAMDOC_AGY_ENABLED=false
# Where StreamDoc writes its vendored skills (agy picks this up automatically).
STREAMDOC_AGY_INSTALL_DIR=.agents/skills
# Global fallback if the workspace dir above is not writable.
STREAMDOC_AGY_GLOBAL_DIR=~/.gemini/config/skills
# Default agy skill (must be present under assets/skills/agy/ or installed).
STREAMDOC_AGY_DEFAULT_SKILL=web-video-presentation
# Default agy model. Leave blank to use whatever the agy CLI picks.
STREAMDOC_AGY_DEFAULT_MODEL=
# Comma-separated allowlist of agy model ids exposed in the UI. Empty means
# "let the CLI validate at invoke time".
STREAMDOC_AGY_SUPPORTED_MODELS=
# agy prompt template dirs: samples are shipped in assets/prompts/agy/;
# user overrides go in config/prompts/agy/ (gitignored).
STREAMDOC_AGY_TEMPLATES_DIR=config/prompts/agy
STREAMDOC_AGY_SAMPLE_PROMPTS_DIR=assets/prompts/agy
# Per-invocation wait timeout (seconds) when StreamDoc runs agy.
STREAMDOC_AGY_DEFAULT_WAIT_TIMEOUT=600
# Where agy artifacts land locally (mirrors the NotebookLM layout).
STREAMDOC_AGY_OUTPUT_DIR=data/Outputs/agy
# Auto-provision vendored skills on startup (copies assets/skills/agy/*
# into .agents/skills/). Idempotent — existing skills are skipped.
STREAMDOC_AGY_AUTO_PROVISION_SKILLS=true
# Auto-update skills from upstream on startup via `npx skills add`.
# When true, startup fetches the latest skill revisions before installing.
# When false, use the "Update from upstream" button on the Antigravity page.
STREAMDOC_AGY_SKILLS_AUTO_UPDATE=false
# Comma-separated upstream sources for `npx skills add`.
# Format: "<github-repo>--skill <skill-name>"
STREAMDOC_AGY_SKILLS_UPDATE_SOURCES=heredotnow/skill--skill here-now

# Telegram notification (POR-27). With both bot token + chat id set and
# STREAMDOC_NOTIFY_TELEGRAM_ENABLED=true, successful agy runs send a
# message containing the here.now URL. Either blank = no-op.
STREAMDOC_NOTIFY_TELEGRAM_ENABLED=false
STREAMDOC_NOTIFY_TELEGRAM_BOT_TOKEN=
STREAMDOC_NOTIFY_TELEGRAM_CHAT_ID=

# Social platform configuration
STREAMDOC_SOCIAL_DEFAULT_LOOKBACK_HOURS=12
STREAMDOC_SOCIAL_DEFAULT_MAX_POSTS=200
STREAMDOC_SOCIAL_REDDIT_ENABLED=true
STREAMDOC_SOCIAL_STOCKTWITS_ENABLED=true
STREAMDOC_SOCIAL_X_ENABLED=true
# Optional absolute paths to the twitter / rdt CLIs (auto-detected if blank).
STREAMDOC_TWITTER_CLI_BINARY_PATH=
STREAMDOC_RDT_CLI_BINARY_PATH=
# Manual session-cookie fallback (e.g. Windows DPAPI / Chrome lock).
STREAMDOC_TWITTER_AUTH_TOKEN=
STREAMDOC_TWITTER_CT0=
# Optional Reddit cookie header. Also used to seed rdt-cli when browser extraction fails.
STREAMDOC_REDDIT_COOKIE=
# Playwright browser for interactive social login and headless refresh.
STREAMDOC_SOCIAL_BROWSER=chromium
# Optional Chrome DevTools endpoint (start Chrome with --remote-debugging-port=9222).
STREAMDOC_SOCIAL_CDP_URL=
# Where captured social cookies are stored.
STREAMDOC_SOCIAL_AUTH_STORAGE_ROOT=data/integrations/social
STREAMDOC_SOCIAL_LOGIN_TIMEOUT_SECONDS=300
STREAMDOC_SOCIAL_REFRESH_TIMEOUT_SECONDS=30
# Automatic headless re-auth interval in hours (0 to disable).
# Only platforms that are enabled (STREAMDOC_SOCIAL_*_ENABLED=true) AND
# already authenticated (have a prior interactive login) are refreshed.
STREAMDOC_SOCIAL_AUTH_REFRESH_INTERVAL_HOURS=6
STREAMDOC_CURL_CFFI_IMPERSONATE=chrome133a
STREAMDOC_STOCKTWITS_API_BASE=https://api.stocktwits.com/api/2/
