# ── Secrets & local config ────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
cookies/
data/cookies/

# ── Runtime data (regenerated by the app; never commit) ───────────────
# The app auto-creates these dirs on startup. Only sample prompts live in
# assets/prompts/ and ARE tracked. Everything under data/ is runtime output,
# downloaded media, SQLite state, and integration secrets (Google cookies).
data/*
!data/.gitkeep
!data/**/.gitkeep

# ── Integration secrets (Google cookies / browser profile) ────────────
config/integrations/notebooklm/storage_state.json
config/integrations/notebooklm/browser_profile/

# ── User config (presets, prompts — gitignored, not committed) ────────
# Reason: user-created presets and prompts live in config/ so they never
# pollute the tracked repo. Sample prompts in assets/prompts/ ARE tracked.
# Shipped sample presets in config/presets/sample-*.yaml ARE tracked.
config/presets/*
!config/presets/sample-*.yaml
config/prompts/

# ── Python caches & build artifacts ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ── Built frontend (regenerated by `npm run build` / Docker) ──────────
src/streamdoc/api/static/
frontend/dist/
frontend/node_modules/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts
# Reason: a NotebookLM session (Google cookies) was accidentally created under
# frontend/data when login ran with cwd=frontend. Never commit browser profiles.
frontend/data/

# ── Third-party binaries (downloaded at runtime, not committed) ───────
src/streamdoc/bin/*.exe

# ── Temp / scratch / editor / OS ──────────────────────────────────────
tmp_test/
*.bak
*.tmp
*.log
# Stray download-test media (download partials / test output never committed)
*.mp4.part
test_*.mp4
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Agent tooling local state ─────────────────────────────────────────
.hermes/
.devin/config.local.json
.devin/plans/

# ── Local agent instructions & scratch (never committed) ──────────────
# Reason: .agents/ holds local PRD/SYSTEM/skill working copies for coding
# agents; shipped skills live in assets/skills/ instead. The .devin-* and
# devin-handoff/qa-report files are agent session exports/summaries that
# contain local data and must never be published.
.agents/
.devin-*.json
.devin-*.md
.devin-pid
devin-handoff.md
qa-report.md
_tmp_pypi.py
nul

# ── here.now publish state (local runtime artifact) ───────────────────
.herenow/

# ── Local presentation/script artifacts (generated, not source) ──────
presentation.html
script.md

# ── Git worktrees ─────────────────────────────────────────────────────
.worktrees/
